# Local development defaults only. Use strong, unique values outside local development.
APP_NAME=UniMind AI
APP_ENV=development

POSTGRES_DB=unimind
POSTGRES_USER=unimind
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
# When changing WEB_HOST_PORT, align FRONTEND_URL, CORS_ORIGINS, and CLERK_AUTHORIZED_PARTIES below.
WEB_HOST_PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://unimind:change-me-for-local-development@localhost:5432/unimind
REDIS_URL=redis://localhost:6379/0

# CORS and Clerk origins should include the frontend origin.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Comma-separated Clerk IDs are granted admin on sign-in; remove an ID after promotion.
ADMIN_CLERK_USER_IDS=
CROSSREF_MAILTO=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AGENT_EXECUTION_TIMEOUT_SECONDS=120
# Defaults to enabled only when APP_ENV=production; set true/false to override.
# API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
INSTALL_HF_INFERENCE=false
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_EMBEDDING_DIMENSIONS=1024
HF_RERANKER_MODEL=BAAI/bge-reranker-base
HF_RERANKER_ENABLED=true
HF_DEVICE=cpu
HF_BATCH_SIZE=8

# Optional production Compose settings; use unique generated values before deployment.
GHCR_OWNER=your-github-owner
IMAGE_TAG=latest
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
METRICS_BEARER_TOKEN=
REDIS_PASSWORD=
# REDIS_URL=redis://:url-encoded-password@redis:6379/0

# Browser end-to-end tests (apps/web).
# PLAYWRIGHT_TEST_BASE_URL must point to a running Next.js dev or prod server.
# PLAYWRIGHT_CHANNEL=chrome uses the system Google Chrome install (no download
# needed). Omit it to use Playwright's bundled Chromium (requires network access
# to download with: cd apps/web && pnpm exec playwright install chromium).
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000