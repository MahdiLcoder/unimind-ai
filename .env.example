# Local development defaults only. Use strong, unique values outside local development.
APP_NAME=UniMind AI
APP_ENV=development

POSTGRES_DB=unimind
POSTGRES_USER=unimind
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://unimind:change-me-for-local-development@localhost:5432/unimind
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_EMBEDDING_DIMENSIONS=1024
HF_RERANKER_MODEL=BAAI/bge-reranker-base
HF_DEVICE=cpu
HF_BATCH_SIZE=8
