{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unimind-ai:schemas:academic-question:v1",
  "title": "UniMind reviewed academic evaluation question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "question",
    "reference_answer",
    "relevant_chunk_ids",
    "expected_agents",
    "expected_citations",
    "source_references",
    "verified_by",
    "verified_at",
    "dataset_version"
  ],
  "properties": {
    "question_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "reference_answer": { "type": "string", "minLength": 1 },
    "relevant_chunk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "expected_agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["knowledge", "learning", "research", "coding", "planning", "university_services"]
      }
    },
    "expected_citations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_by": { "type": "string", "minLength": 1, "maxLength": 200 },
    "verified_at": { "type": "string", "format": "date-time" },
    "dataset_version": { "type": "string", "minLength": 1, "maxLength": 80 }
  }
}
