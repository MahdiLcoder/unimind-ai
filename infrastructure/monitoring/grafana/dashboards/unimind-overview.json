        {
          "expr": "histogram_quantile(0.95, sum by (agent, le) (rate(unimind_agent_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}} p95",
          "refId": "A"
        }
      ],
      "title": "Agent execution duration",
      "type": "timeseries"
